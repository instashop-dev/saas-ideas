{
  "name": "saas-ideas",
  "version": "1.0.0",
  "private": true,
  "description": "Git-native multi-agent SaaS opportunity discovery engine",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "format": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "format:fix": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "bootstrap": "tsx src/cli/bootstrap.ts",
    "discovery": "tsx src/cli/discovery.ts",
    "stage:pain-mine": "tsx src/cli/stage-pain-mine.ts",
    "stage:cluster": "tsx src/cli/stage-cluster.ts",
    "stage:validate": "tsx src/cli/stage-validate.ts",
    "stage:competition": "tsx src/cli/stage-competition.ts",
    "stage:debate": "tsx src/cli/stage-debate.ts",
    "stage:judge": "tsx src/cli/stage-judge.ts",
    "stage:report": "tsx src/cli/stage-report.ts"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "zod": "^3.23.0"
  }
}
